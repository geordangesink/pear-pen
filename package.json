{
  "name": "pear-pen-desktop",
  "productName": "PearPen",
  "version": "1.0.0",
  "description": "A quiet place to sign together.",
  "license": "Apache-2.0",
  "private": true,
  "type": "commonjs",
  "main": "electron/main.js",
  "upgrade": "pear://hzy48wazh7yndmzj85q5pcd3emjpjnbwuhuq6o7kzm6ejnf3eoso",
  "scripts": {
    "start": "electron-forge start -- --no-updates",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:darwin": "electron-forge make --platform=darwin",
    "make:win32": "electron-forge make --platform=win32",
    "make:linux": "electron-forge make --platform=linux",
    "make:linux:appimage": "electron-forge make --platform=linux --targets=pear-electron-forge-maker-appimage",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test core/test/*.test.js",
    "check:upgrade": "node scripts/check-upgrade.js"
  },
  "dependencies": {
    "pear-pen-core": "file:core",
    "framed-stream": "^1.0.1",
    "hyper-multisig": "2.5.0",
    "hypercore-sign-v4": "npm:hypercore-sign@4.1.1",
    "paparam": "^1.10.0",
    "pear-runtime": "^1.3.1",
    "hypercore-signing-request": "5.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "electron": "^42.0.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.2",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "hypercore-sign": "3.0.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "pear-link": "^5.0.1",
    "prettier": "^3.8.1"
  },
  "overrides": {
    "hyper-multisig@2.5.0": {
      "hypercore-sign-lib": "$hypercore-sign-v4"
    },
    "hypercore-signing-request": {
      "hypercore": "^11.40.3",
      "hyperdrive": "^13.3.4"
    }
  },
  "grocer": {
    "upgrades": {
      "production": "pear://kerdqeiyou17u8whw9457ym583dj6c4woe4r6pmerrij655uhu8y",
      "dev": "pear://hzy48wazh7yndmzj85q5pcd3emjpjnbwuhuq6o7kzm6ejnf3eoso",
      "provision": "pear://cdtew53x9u1u58hs4epzbregp98dskwe48xynczn4sd7y48s514y"
    }
  }
}
